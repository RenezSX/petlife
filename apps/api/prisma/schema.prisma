generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("RECEPTIONIST")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}


model Professional {
  id        String   @id @default(cuid())
  name      String
  role      String
  crmv      String?  @unique
  specialty String?
  phone     String?
  email     String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  attachments ClinicalAttachment[]
  preventives PreventiveRecord[]
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([role])
  @@index([active])
}

model Tutor {
  id        String   @id @default(cuid())
  name      String
  cpf       String?  @unique
  phone     String
  whatsapp  String?
  email     String?
  address   String?
  notes     String?
  active    Boolean  @default(true)
  animals   Animal[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([active])
}

model Animal {
  id                    String            @id @default(cuid())
  name                  String
  species               String
  breed                 String?
  sex                   String?
  birthDate             DateTime?
  approximateAge        String?
  weight                Float?
  color                 String?
  microchip             String?           @unique
  neutered              Boolean           @default(false)
  allergies             String?
  previousDiseases      String?
  continuousMedications String?
  notes                 String?
  photoUrl               String?
  active                 Boolean           @default(true)
  tutorId               String
  tutor                 Tutor             @relation(fields: [tutorId], references: [id])
  hospitalizations      Hospitalization[]
  attachments           ClinicalAttachment[]
  preventives           PreventiveRecord[]
  financialEntries      FinancialEntry[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([name])
  @@index([species])
  @@index([tutorId])
  @@index([active])
}

model Bed {
  id               String            @id @default(cuid())
  name             String            @unique
  sector           String
  notes            String?
  active           Boolean           @default(true)
  hospitalizations Hospitalization[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([sector])
  @@index([active])
}

model Hospitalization {
  id              String           @id @default(cuid())
  animalId        String
  animal          Animal           @relation(fields: [animalId], references: [id])
  bedId           String?
  bed             Bed?             @relation(fields: [bedId], references: [id])
  status          String           @default("HOSPITALIZED")
  priority        String           @default("NORMAL")
  reason          String
  diagnosis       String?
  veterinarian    String?
  professionalId  String?
  notes            String?
  admittedAt      DateTime         @default(now())
  expectedDischargeAt DateTime?
  dischargedAt    DateTime?
  dischargeSummary String?
  procedures      Procedure[]
  prescriptions   MedicationPrescription[]
  medicationDoses MedicationDose[]
  clinicalEvents  ClinicalEvent[]
  attachments     ClinicalAttachment[]
  financialEntries FinancialEntry[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status])
  @@index([priority])
  @@index([animalId])
  @@index([bedId])
  @@index([admittedAt])
  @@index([professionalId])
}

model Procedure {
  id                String          @id @default(cuid())
  hospitalizationId String
  hospitalization   Hospitalization @relation(fields: [hospitalizationId], references: [id])
  title             String
  description       String?
  status            String          @default("PENDING")
  responsible       String?
  professionalId    String?
  scheduledAt       DateTime
  completedAt       DateTime?
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([hospitalizationId])
  @@index([status])
  @@index([scheduledAt])
  @@index([professionalId])
}

model MedicationPrescription {
  id                String           @id @default(cuid())
  hospitalizationId String
  hospitalization   Hospitalization  @relation(fields: [hospitalizationId], references: [id])
  medication        String
  dose              String
  unit              String
  route             String
  frequencyHours    Int
  startAt           DateTime
  endAt             DateTime?
  active            Boolean          @default(true)
  notes             String?
  responsible       String?
  professionalId    String?
  inventoryItemId    String?
  inventoryItem      InventoryItem?   @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  inventoryQuantity  Float?
  doses             MedicationDose[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([hospitalizationId])
  @@index([active])
  @@index([professionalId])
  @@index([inventoryItemId])
}

model MedicationDose {
  id                String                   @id @default(cuid())
  hospitalizationId String
  hospitalization   Hospitalization          @relation(fields: [hospitalizationId], references: [id])
  prescriptionId    String?
  prescription      MedicationPrescription?  @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  medication        String
  dose              String?
  unit              String?
  route             String?
  status            String                   @default("PENDING")
  scheduledAt       DateTime
  administeredAt    DateTime?
  administeredBy    String?
  administeredByProfessionalId String?
  inventoryItemId   String?
  inventoryItem     InventoryItem?           @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  inventoryQuantity Float?
  notes             String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([hospitalizationId])
  @@index([prescriptionId])
  @@index([status])
  @@index([scheduledAt])
  @@index([administeredByProfessionalId])
  @@index([inventoryItemId])
}


model ClinicalEvent {
  id                String          @id @default(cuid())
  hospitalizationId String
  hospitalization   Hospitalization @relation(fields: [hospitalizationId], references: [id], onDelete: Cascade)
  type              String          @default("EVOLUTION")
  title             String
  description       String
  responsible       String?
  professionalId    String?
  eventAt           DateTime        @default(now())
  temperature       Float?
  heartRate         Int?
  respiratoryRate   Int?
  weight            Float?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([hospitalizationId])
  @@index([type])
  @@index([eventAt])
  @@index([professionalId])
}

model ClinicalAttachment {
  id                   String           @id @default(cuid())
  animalId             String
  animal               Animal           @relation(fields: [animalId], references: [id], onDelete: Cascade)
  hospitalizationId    String?
  hospitalization      Hospitalization? @relation(fields: [hospitalizationId], references: [id], onDelete: Cascade)
  professionalId       String?
  professional         Professional?     @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  professionalName     String?
  fileName             String
  mimeType             String
  sizeBytes            Int
  dataUrl              String
  description          String?
  category             String           @default("OTHER")
  createdAt            DateTime         @default(now())

  @@index([animalId])
  @@index([hospitalizationId])
  @@index([professionalId])
  @@index([createdAt])
}

model InventoryItem {
  id              String              @id @default(cuid())
  name            String
  category        String              @default("MEDICATION")
  unit            String
  currentQuantity Float               @default(0)
  minimumQuantity Float               @default(0)
  batch           String?
  expiryDate      DateTime?
  supplier        String?
  location        String?
  notes           String?
  active          Boolean             @default(true)
  movements       InventoryMovement[]
  prescriptions   MedicationPrescription[]
  medicationDoses MedicationDose[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([name])
  @@index([category])
  @@index([active])
  @@index([expiryDate])
}

model InventoryMovement {
  id          String        @id @default(cuid())
  itemId      String
  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type        String
  quantity    Float
  beforeQty   Float
  afterQty    Float
  reason      String
  responsible String?
  notes       String?
  createdAt   DateTime      @default(now())

  @@index([itemId])
  @@index([type])
  @@index([createdAt])
}

model FinancialEntry {
  id                String           @id @default(cuid())
  type              String
  description       String
  category          String
  amount            Float
  status            String           @default("PAID")
  paymentMethod     String?
  occurredAt        DateTime
  dueAt             DateTime?
  paidAt            DateTime?
  animalId          String?
  animal            Animal?          @relation(fields: [animalId], references: [id], onDelete: SetNull)
  hospitalizationId String?
  hospitalization   Hospitalization? @relation(fields: [hospitalizationId], references: [id], onDelete: SetNull)
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([type])
  @@index([status])
  @@index([category])
  @@index([occurredAt])
  @@index([animalId])
  @@index([hospitalizationId])
}

model PreventiveRecord {
  id             String        @id @default(cuid())
  animalId       String
  animal         Animal        @relation(fields: [animalId], references: [id], onDelete: Cascade)
  type           String
  name           String
  manufacturer   String?
  batch          String?
  appliedAt      DateTime
  nextDueAt      DateTime?
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  responsible    String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([animalId])
  @@index([type])
  @@index([nextDueAt])
  @@index([professionalId])
}

model ClinicSettings {
  id                 String   @id @default("clinic")
  name               String   @default("PetLife São Caetano")
  legalName          String?
  cnpj               String?
  phone              String?
  whatsapp           String?
  email              String?
  address            String?
  city               String?
  state              String?
  zipCode             String?
  logoDataUrl         String?
  openingHours        String?
  sectorsJson         String   @default("[]")
  prioritiesJson      String   @default("[]")
  speciesJson         String   @default("[]")
  medicationRoutesJson String  @default("[]")
  theme               String   @default("light")
  tagline             String   @default("Cuidando com amor, tratando com excelência.")
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())
}


model BackupLog {
  id         String   @id @default(cuid())
  action     String
  fileName   String
  countsJson String   @default("{}")
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}

model AuditLog {
  id           String   @id
  action       String
  module       String
  entity       String
  entityId     String?
  description  String
  actor        String?  @default("Sistema interno")
  beforeJson   String?
  afterJson    String?
  metadataJson String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([module])
  @@index([action])
  @@index([entityId])
}
